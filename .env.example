# Copy this file to .env and fill it in. .env is gitignored; never commit it.

# Your Anthropic API key, with access to Managed Agents
ANTHROPIC_API_KEY=

# Optional: IDs to reuse instead of creating new ones each run.
# Copy them from a previous run's runs/<run>/ids.json. Leave blank to create new ones.
# The orchestrator is tied to the triager and verifier versions it was created with,
# so set all three agent IDs together, from the same run.

# triage_multi.py
ORCHESTRATOR_ID=
TRIAGER_ID=
VERIFIER_ID=

# triage_demo.py
AGENT_ID=

# Both scripts can share one environment
ENVIRONMENT_ID=
